DSP_ENVIRONMENT=development
DSP_CORS_ORIGINS=http://localhost:5173
DSP_DATABASE_URL=postgresql+psycopg://dsp_portal:dsp_portal@127.0.0.1:5432/dsp_portal
DSP_FRONTEND_BASE_URL=http://localhost:5173

# Authentication providers are inferred from their configuration. There is no
# AUTH_ENABLED, LOCAL_AUTH_ENABLED, or SAML_STRICT switch. Local accounts are
# always supported. Ping SSO is advertised only when its required values are complete.
DSP_JWT_ISSUER=dsp-portal
DSP_JWT_AUDIENCE=dsp-portal-api
DSP_JWT_ALGORITHM=RS256
DSP_JWT_KEY_ID=dsp-local-1
DSP_JWT_SIGNING_KEY_PATH=.secrets/dsp-jwt-private.pem
DSP_JWT_VERIFICATION_KEY_PATH=.secrets/dsp-jwt-public.pem
DSP_JWT_ACCESS_TTL_SECONDS=600
DSP_SESSION_TTL_SECONDS=28800

DSP_SAML_SP_ENTITY_ID=
DSP_SAML_ACS_URL=
DSP_SAML_IDP_SSO_URL=
DSP_SAML_EXPECTED_ISSUER=
DSP_SAML_IDP_CERTIFICATE_PATH=
DSP_SAML_IDP_METADATA_URL=
DSP_SAML_IDP_METADATA_PATH=
# Allowed values: response, assertion, both. Unsigned assertions are never allowed.
DSP_SAML_SIGNATURE_PROFILE=response
DSP_SAML_DURABLE_SUBJECT_ATTRIBUTE=USER_ID
DSP_SAML_GROUPS_ATTRIBUTE=LDAP_GROUPS
DSP_SAML_EMAIL_ATTRIBUTE=EMAIL
DSP_SAML_GIVEN_NAME_ATTRIBUTE=GIVEN_NAME
DSP_SAML_FAMILY_NAME_ATTRIBUTE=FAMILY_NAME
DSP_SAML_EMPLOYEE_ID_ATTRIBUTE=EMPLOYEE_ID
DSP_SAML_CLOCK_SKEW_SECONDS=60
# At least one approved LDAP group is required before Ping is advertised.
DSP_ACCESS_GROUPS=
DSP_ADMIN_GROUPS=

DSP_LOGIN_TRANSACTION_TTL_SECONDS=300
DSP_AUTH_CODE_TTL_SECONDS=60
DSP_LOCAL_PASSWORD_ACTION_TTL_SECONDS=900
DSP_LOCAL_PASSWORD_MIN_LENGTH=12
DSP_LOCAL_MAX_FAILURES=5
DSP_LOCAL_LOCK_SECONDS=900
DSP_AUTH_RATE_LIMIT_PER_MINUTE=30
DSP_LOCAL_AUTH_RATE_LIMIT_PER_MINUTE=10
DSP_AUTH_CLEANUP_BATCH_SIZE=500
DSP_ADMIN_REAUTH_SECONDS=3600
DSP_AUTH_JSON_BODY_LIMIT_BYTES=16384
DSP_SAML_BODY_LIMIT_BYTES=2097152
DSP_PREAUTH_SUPPORT_URL=

# Optional one-time bootstrap. The account is created only when no ADMIN exists;
# remove these values after the first administrator signs in.
DSP_BOOTSTRAP_ADMIN_USERNAME=
DSP_BOOTSTRAP_ADMIN_PASSWORD=
DSP_BOOTSTRAP_ADMIN_DISPLAY_NAME=DSP Local Administrator

# Replace these with the bank's real destinations before release one.
DSP_CONFLUENCE_DSP_URL=
DSP_CONFLUENCE_STATUS_URL=
DSP_CONFLUENCE_RELEASES_URL=
DSP_REMEDY_TICKETS_URL=
DSP_REMEDY_REQUESTS_URL=
DSP_TEAMS_SUPPORT_URL=
DSP_SUPPORT_ROSTER_NAME=Alex Johnson
DSP_SUPPORT_ROSTER_ROLE=DSP support duty engineer

# Optional per-service overrides. Keep this JSON on one line in the real .env file.
# Supported keys: dev-container, cyberark, nexus, compute, cdp, trino, sas.
DSP_SUPPORT_SERVICE_LINKS={"cyberark":{"remedyUrl":"","confluenceUrl":"","teamsUrl":""},"nexus":{"remedyUrl":"","confluenceUrl":"","teamsUrl":""}}

# Optional onboarding, bootcamp, and training destinations.
DSP_ONBOARDING_LINKS={"setupGuideUrl":"","accessMatrixUrl":"","bootcampAgendaUrl":"","bootcampRegisterUrl":"","trainingLibraryUrl":""}
